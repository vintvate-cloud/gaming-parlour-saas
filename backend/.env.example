# Which database adapter to use: "local", "mongo", or "sheets"
# Use "mongo" for production deployment - free, no setup beyond a connection string.
DB_PROVIDER=local

# Server port
PORT=5000

# JWT secret - change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production

# Allowed origin for CORS (your frontend URL). Use * for local dev only.
CORS_ORIGIN=http://localhost:5173

# --- Only needed when DB_PROVIDER=mongo ---
# Get this from MongoDB Atlas (free tier): https://www.mongodb.com/cloud/atlas
# Looks like: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=
# Optional - defaults to "gaming_parlour" if not set
MONGODB_DB_NAME=gaming_parlour

# --- Only needed when DB_PROVIDER=sheets ---
# The ID of your Google Sheet (found in its URL between /d/ and /edit)
GOOGLE_SHEET_ID=

# Service account credentials (paste the full JSON on one line, or use a file path below)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
